# Copy this file to .env and replace every placeholder before deploying.
# .env is ignored by git and Docker builds.

PORT=10000
# Generate with: openssl rand -base64 48
JWTSECRET=replace-with-at-least-32-random-bytes
APP_BASE_URL=http://localhost:10000
# Use * to allow any browser origin (credentialed CORS is disabled automatically).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local MongoDB for development. For Docker or production, use your deployed
# MongoDB connection string here (or set DB_CONNECTION_STRING instead).
MONGODB_URI=mongodb://localhost:27017
DB_NAME=gordian

# Credentials are applied only when MONGODB_URI has none. Prefer putting
# credentials in the URI for deployed databases.
# DB_USERNAME=gordian
# DB_PASSWORD=change-me-in-production
# DB_AUTH_SOURCE=admin

TRUST_PROXY=false
DEBUG=false

# Optional email delivery. Set both values or neither.
# GMAIL_USERNAME=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-google-app-password

# Optional tunables (defaults shown).
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h
# EMAIL_CONFIRMATION_TOKEN_TTL=48h
# PASSWORD_RESET_TOKEN_TTL=1h
# BCRYPT_COST=12
# MAX_BODY_MB=8
# MAX_PROFILE_PICTURE_MB=5
# APP_TEMPLATES_DIR=/app/internal/templates
