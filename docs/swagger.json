{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Authentication and user management REST API for Gordian",
        "title": "Gordian API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/confirm-email/{token}": {
            "get": {
                "description": "Confirms an email address using the token sent by email and renders a confirmation page.",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Confirm email address",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Confirmation token",
                        "name": "token",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML page with success message",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "HTML page with failure message",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "HTML page with failure message",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/delete": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Permanently deletes the authenticated user's account.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Delete user account",
                "responses": {
                    "200": {
                        "description": "Account deleted successfully",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "Account not found or already deleted",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/fetchuser": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves the authenticated user's profile.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Fetch current user",
                "responses": {
                    "200": {
                        "description": "User profile retrieved successfully",
                        "schema": {
                            "$ref": "#/definitions/data.UserResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "User profile not found",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/fetchuserbyid": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves a limited public profile by user ID. Birthdate, email and confirmation state are never returned.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Fetch user by ID",
                "parameters": [
                    {
                        "description": "User ID",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.FetchUserByIDRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User fetched successfully",
                        "schema": {
                            "$ref": "#/definitions/data.PublicProfileResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error or invalid user ID format",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "The specified user could not be found",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns service health status and details.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Service health check",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "schema": {
                            "$ref": "#/definitions/data.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service health check failed",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "Authenticates with username/email and password. Invalid identifiers and passwords return the same response.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login to the application",
                "parameters": [
                    {
                        "description": "Login request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "schema": {
                            "$ref": "#/definitions/data.LoginRegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "403": {
                        "description": "Email not confirmed",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "429": {
                        "description": "Too many failed login attempts",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Revokes all access and refresh tokens for the authenticated user.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Log out",
                "responses": {
                    "200": {
                        "description": "Logged out successfully",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/password-reset/confirm": {
            "post": {
                "description": "Sets a new password using a single-use reset token. All existing sessions are revoked.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Confirm password reset",
                "parameters": [
                    {
                        "description": "Password reset confirm request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.PasswordResetConfirmRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Password reset successfully",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error or invalid/expired reset token",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/password-reset/initiate": {
            "post": {
                "description": "Sends a password reset token if the account exists. The response is identical for unknown addresses so accounts cannot be enumerated.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Initiate password reset",
                "parameters": [
                    {
                        "description": "Password reset request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.PasswordResetInitiateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "If an account exists with this email, a reset link will be sent",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too many password reset requests",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/refresh": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Exchanges a valid refresh token for a new token pair. Deleted users, revoked sessions and unconfirmed email addresses are rejected.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh authentication tokens",
                "responses": {
                    "200": {
                        "description": "Tokens refreshed successfully",
                        "schema": {
                            "$ref": "#/definitions/data.TokenResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "403": {
                        "description": "Email not confirmed",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Creates a new account and sends an email confirmation link. If email delivery fails the account is still created; use the resend endpoint.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Registration request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Registration successful",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Username or email is already registered",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "429": {
                        "description": "Too many registration attempts",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/resend-confirmation-email": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Resends the email confirmation to the authenticated user. Prefer the unauthenticated POST variant when login is blocked.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Resend confirmation email (authenticated)",
                "responses": {
                    "200": {
                        "description": "Confirmation email sent successfully",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "User profile not found",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "409": {
                        "description": "Email is already confirmed",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "429": {
                        "description": "Too many confirmation email requests",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Unable to resend confirmation email",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Sends a new confirmation email when an unconfirmed account exists. Always returns the same response.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Resend confirmation email by address",
                "parameters": [
                    {
                        "description": "Email address",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.ResendConfirmationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "If an account exists and is unconfirmed, an email will be sent",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        },
        "/update": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Updates the authenticated user's profile. Changing the email or password requires current_password; a password change also revokes all existing sessions and returns a new token pair.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Update user profile",
                "parameters": [
                    {
                        "description": "Update request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.UpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Profile updated successfully",
                        "schema": {
                            "$ref": "#/definitions/data.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error, no update fields, or missing current password",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized or current password incorrect",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "User profile not found",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "409": {
                        "description": "Username or email is already registered",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Updates the authenticated user's profile. Changing the email or password requires current_password; a password change also revokes all existing sessions and returns a new token pair.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Update user profile",
                "parameters": [
                    {
                        "description": "Update request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data.UpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Profile updated successfully",
                        "schema": {
                            "$ref": "#/definitions/data.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Validation error, no update fields, or missing current password",
                        "schema": {
                            "$ref": "#/definitions/data.ValidationErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized or current password incorrect",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "User profile not found",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "409": {
                        "description": "Username or email is already registered",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/data.MessageResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "data.FetchUserByIDRequest": {
            "type": "object",
            "required": [
                "user_id"
            ],
            "properties": {
                "user_id": {
                    "type": "string",
                    "example": "615f2e0a6c6d5c0e1a1e4a01"
                }
            }
        },
        "data.HealthResponse": {
            "type": "object",
            "properties": {
                "details": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "data.LoginRegisterResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "tokens": {
                    "$ref": "#/definitions/data.SessionTokens"
                },
                "user": {
                    "$ref": "#/definitions/data.User"
                }
            }
        },
        "data.LoginRequest": {
            "type": "object",
            "required": [
                "identifier",
                "password"
            ],
            "properties": {
                "identifier": {
                    "type": "string",
                    "maxLength": 254,
                    "example": "johndoe"
                },
                "password": {
                    "type": "string",
                    "maxLength": 128,
                    "example": "P@ssw0rd!"
                }
            }
        },
        "data.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "data.PasswordResetConfirmRequest": {
            "type": "object",
            "required": [
                "new_password",
                "token"
            ],
            "properties": {
                "new_password": {
                    "type": "string",
                    "example": "NewP@ssw0rd!"
                },
                "token": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                }
            }
        },
        "data.PasswordResetInitiateRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "example": "john@example.com"
                }
            }
        },
        "data.PublicProfile": {
            "type": "object",
            "properties": {
                "date_joined": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "profile_picture": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "data.PublicProfileResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/data.PublicProfile"
                }
            }
        },
        "data.PublicUser": {
            "type": "object",
            "properties": {
                "birthdate": {
                    "type": "string"
                },
                "date_joined": {
                    "type": "string"
                },
                "email_confirmed": {
                    "type": "boolean"
                },
                "first_name": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "profile_picture": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "data.RegisterRequest": {
            "type": "object",
            "required": [
                "accept_terms",
                "birthdate",
                "email",
                "first_name",
                "last_name",
                "password",
                "username"
            ],
            "properties": {
                "accept_terms": {
                    "type": "boolean",
                    "example": true
                },
                "birthdate": {
                    "type": "string",
                    "example": "1990-01-01T00:00:00Z"
                },
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "example": "john@example.com"
                },
                "first_name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2,
                    "example": "John"
                },
                "last_name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 2,
                    "example": "Doe"
                },
                "password": {
                    "type": "string",
                    "example": "P@ssw0rd!"
                },
                "profile_picture": {
                    "type": "string",
                    "example": "data:image/png;base64,iVBORw0..."
                },
                "username": {
                    "type": "string",
                    "maxLength": 20,
                    "minLength": 5,
                    "example": "johndoe"
                }
            }
        },
        "data.ResendConfirmationRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254,
                    "example": "john@example.com"
                }
            }
        },
        "data.SessionTokens": {
            "type": "object",
            "properties": {
                "access_created_at": {
                    "type": "string"
                },
                "access_expires_at": {
                    "type": "string"
                },
                "access_token": {
                    "type": "string"
                },
